# OpenRouter (required)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional model override (GitHub Actions variable: LUFFY_MODEL)
# Script default (F26): anthropic/claude-opus-5 — paid; leave unset to use it.
# LUFFY_MODEL=anthropic/claude-opus-5
# Cheaper smoke / cost-sensitive targets:
# LUFFY_MODEL=openai/gpt-5-mini

# Optional Hermes pin (GitHub Actions variable: LUFFY_HERMES_COMMIT)
# Default: known-good SHA in scripts/hermes-pin.sh. Use latest|main to float.
# LUFFY_HERMES_COMMIT=53559aaf86b84dadae83cd9bb605ca476f9a0606

# Hub memory (target → Mr-Ashish/luffy-pr-review-agent)
# LUFFY_HUB_TOKEN=ghp_...
# LUFFY_HUB_REPO=Mr-Ashish/luffy-pr-review-agent
# LUFFY_HUB_PUBLISH=1

# Local helpers
# REPO=owner/repo
# PR_NUMBER=123
# POST_COMMENT=0
# MAX_DIFF_BYTES=400000

# Optional re-trigger cooldown seconds (GitHub var: LUFFY_COOLDOWN_SECONDS; 0=off)
# LUFFY_COOLDOWN_SECONDS=900

# Optional prebaked runner image (GitHub var: LUFFY_RUNNER_IMAGE)
# LUFFY_RUNNER_IMAGE=ghcr.io/mr-ashish/luffy-hermes-runner:53559aaf86b8

# F22: post commit status on PR head (GitHub var LUFFY_COMMIT_STATUS; 0=off)
# LUFFY_COMMIT_STATUS=1
# LUFFY_STATUS_CONTEXT=luffy/review
