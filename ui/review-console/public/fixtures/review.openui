root = Stack([hdr, verdictCallout, metaText, summaryCard, blockingCallout, findingsHeader, findingsTable, securityText, costCard, stagesHeader, stagesTable, footer])
hdr = CardHeader("Luffy Review — Odoo PR #3", "Interactive review · OpenUI")
verdictCallout = Callout("error", "Verdict: REQUEST CHANGES", "Score 42/100 · Effort 4/5 · Confidence high")
metaText = TextContent("Luffy structured review rendered via OpenUI Lang (deterministic converter — no second LLM).", "small")
summaryCard = TextContent("The diagnosis in this PR is correct and valuable: the old `remove_control_characters` encoded a Unicode character class with `.encode()` and applied it as a **bytes** regex, which collapsed multi-byte ranges and let `U+FFFE`/`U+FFFF` survive into lxml. The new `str` path in `odoo/tools/xml_utils.py` genuinely fixes that, and `addons/account/tools/dict_to_xml.py` is correctly simplified. However, the new **bytes** path uses `errors='surrogatepass'`, which does *not* do what the code comment claims — it raises `UnicodeDecodeError` on exactly the legacy non-UTF-8 EDI payloads it says it protec…", "default")
blockingCallout = Callout("error", "Blocking (3)", "**`odoo/tools/xml_utils.py` — `errors='surrogatepass'` cannot decode non-UTF-8 bytes and breaks `cleanup_xml_node`.** `s | **`odoo/addons/test_testing_utilities/tests/test_xml_tools.py` — `test_non_utf8_bytes_do_not_raise` fails against the co | **Naive `surrogateescape` swap silently destroys data — the surrogate range must be preserved through the filter.** Wort")
findingsHeader = CardHeader("Key findings", "")
findingsTable = Table([Col("Severity", ["critical", "high", "medium", "low"], "string"), Col("File", ["`odoo/tools/xml_utils.py`", "`odoo/addons/test_testing_utilities/tests/test_xml_tools.py`", "`odoo/tools/xml_utils.py`", "`odoo/tools/xml_utils.py`"], "string"), Col("Issue", ["`surrogatepass` raises `UnicodeDecodeError` on non-UTF-8 bytes", "`test_non_utf8_bytes_do_not_raise` fails against this PR's own implementation", "Stripping the surrogate range after a `surrogateescape` decode silently deletes accented characters", "Docstring promises \"returns the **same type**\" but `bytearray`/`memoryview` return `bytes`"], "string")])
securityText = TextContent("**Security audit:** `No` — no injection, secrets, XSS, or authz concerns. `resolve_entities=False` is untouched, so XXE posture is unchanged, and the sanitizer becomes strictly *more* aggressive on the `str` path. Note the availability angle though: an attacker-influenced non-UTF-8 attachment can now trigger an unhandled `UnicodeDecodeError` in an EDI import path that previously degraded gracefully — a DoS-flavour…", "small")
costCard = Callout("info", "Cost / usage (F21)", "model=`anthropic/claude-opus-5` · ~$0.59 · 195197 tokens · 10 API calls")
stagesHeader = CardHeader("Pipeline stages", "")
